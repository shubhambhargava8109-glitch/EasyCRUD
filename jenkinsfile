pipeline {
    agent any
    stage('Git pull') {
            steps {
                git branch: 'main', url: 'https://github.com/djain2558-cyber/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                sh 'make'
            }
        }
        stage('Test'){
            steps {
                sh 'make check'
                junit 'reports/**/*.xml'
            }
        }
        stage('Deploy') {
            steps {
                sh 'make publish' //
            }
        }
    }
}
