pipeline {
    agent any
    stages {
        stage('Git pull') {
            steps {
                git branch: 'main', url: 'https://github.com/shubhambhargava8109-glitch/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                sh '''cd backend 
                  mvn clean package -DskipTests'''     
            }
        }
        stage('Test') {
                steps {
                   withSonarQubeEnv('SonarQube') {
                     sh '''  
                       cd backend
                         mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar
                           '''
        stage('Deploy') {
            steps {
               echo 'deploy'
            }
        }
    }
}
