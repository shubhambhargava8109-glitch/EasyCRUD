pipeline {
    agent any
    stages {
        stage('Git pull') {
            steps {
                git branch: 'main', url: 'https://github.com/shubhambhargava8109-glitch/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                sh '''cd backend 
                  mvn clean package -DskipTests'''     
            }
        }
        stage('Test') {
            steps {
               echo 'Test'
            }
        }
        stage('Deploy') {
            steps {
               echo 'deploy'
            }
        }
    }
}
